package com.example.droolsotel.rules

import com.example.droolsotel.model.CustomerFact;
global com.example.droolsotel.service.CustomerDbService dbService;
global org.slf4j.Logger logger;

// Declared types for forward chaining and multiple firings
declare LoyaltyPoint
    points : int
    processed : boolean
end

declare Coupon
    code : String
    discountVal : double
    used : boolean
end

// ==========================================
// 1. PREPARE PHASE
// ==========================================

rule "Dummy Prepare Rule"
    agenda-group "prepare"
    salience 1000
    when
        $customer : CustomerFact()
    then
        logger.info("[Prepare Phase] Starting rules preparation for: {}", $customer.getName());
        $customer.addAppliedRule("[Phase: Prepare] Rule engine processing initialized");
end

rule "Fetch Membership Tier from Database"
    agenda-group "prepare"
    salience 500
    when
        $customer : CustomerFact( memberId != null, membershipTier == null || membershipTier == "" )
    then
        logger.info("[Prepare Phase] Fetching membership tier for member: {} from HSQLDB...", $customer.getMemberId());
        String tier = dbService.getMembershipTier($customer.getMemberId());
        modify($customer) {
            setMembershipTier(tier),
            addAppliedRule("Fetch Membership Tier from HSQLDB (" + tier + ")")
        }
end

rule "Fetch Base Tier Discount from Database"
    agenda-group "prepare"
    salience 450
    when
        $customer : CustomerFact( membershipTier != null && membershipTier != "", discountPercentage == 0.0, appliedRules not contains "Database Tier Discount" )
    then
        logger.info("[Prepare Phase] Fetching base discount % for tier: {} from HSQLDB...", $customer.getMembershipTier());
        double pct = dbService.getTierDiscountPercentage($customer.getMembershipTier());
        modify($customer) {
            addDiscount(pct),
            addAppliedRule("Database Tier Discount")
        }
end

// ==========================================
// 2. BUSINESS RULES PHASE
// ==========================================

rule "Dummy Business Rule"
    agenda-group "business-rules"
    salience 1000
    when
        $customer : CustomerFact()
    then
        logger.info("[Business Rules Phase] Applying core business logic for: {}", $customer.getName());
        $customer.addAppliedRule("[Phase: Business-Rules] Core discount rules evaluating");
end

rule "Generate Loyalty Points"
    agenda-group "business-rules"
    salience 400
    when
        $customer : CustomerFact( purchaseAmount >= 500.0 )
        not LoyaltyPoint()
    then
        logger.info("[Business Rules Phase] Generating 2 LoyaltyPoint vouchers for high spender: {}", $customer.getName());
        insert(new LoyaltyPoint(100, false));
        insert(new LoyaltyPoint(200, false));
end

rule "Process Loyalty Point"
    agenda-group "business-rules"
    salience 300
    when
        $lp : LoyaltyPoint( processed == false, $pts : points )
        $customer : CustomerFact()
    then
        logger.info("[Business Rules Phase] Processing LoyaltyPoint voucher ({} pts) for: {}", $pts, $customer.getName());
        modify($lp) {
            setProcessed(true)
        }
        modify($customer) {
            addDiscount(2.5),
            addAppliedRule("Processed Loyalty Point Voucher (+" + $pts + " pts)")
        }
end

rule "Evaluate VIP Status"
    agenda-group "business-rules"
    salience 100
    when
        $customer : CustomerFact( purchaseAmount >= 1000.0, membershipTier != "PLATINUM" )
    then
        logger.info("[Business Rules Phase] Upgrade {} to PLATINUM tier due to large purchaseAmount", $customer.getName());
        modify($customer) {
            setMembershipTier("PLATINUM"),
            addAppliedRule("Upgrade to PLATINUM tier (Auto-VIP)")
        }
end

rule "Evaluate High-Spender Age Reward"
    agenda-group "business-rules"
    salience 30
    when
        $customer : CustomerFact( age >= 60, purchaseAmount >= 500.0, membershipTier == "REGULAR" )
    then
        logger.info("[Business Rules Phase] Upgrade {} to GOLD tier due to age and spending", $customer.getName());
        modify($customer) {
            setMembershipTier("GOLD"),
            addAppliedRule("Upgrade to GOLD tier (Senior Reward)")
        }
end

rule "Senior Customer Discount"
    agenda-group "business-rules"
    salience 10
    when
        $customer : CustomerFact( age >= 65, appliedRules not contains "Senior Customer Discount (+10%)" )
    then
        modify($customer) {
            addDiscount(10.0),
            addAppliedRule("Senior Customer Discount (+10%)")
        }
        logger.info("[Business Rules Phase] Senior Customer Discount applied for: {}", $customer.getName());
end

rule "Youth Customer Discount"
    agenda-group "business-rules"
    salience 10
    when
        $customer : CustomerFact( age < 18, appliedRules not contains "Youth Customer Discount (+5%)" )
    then
        modify($customer) {
            addDiscount(5.0),
            addAppliedRule("Youth Customer Discount (+5%)")
        }
        logger.info("[Business Rules Phase] Youth Customer Discount applied for: {}", $customer.getName());
end

rule "Large Purchase Bonus Discount"
    agenda-group "business-rules"
    salience 5
    when
        $customer : CustomerFact( purchaseAmount >= 500.0, appliedRules not contains "Large Purchase Bonus Discount (+5%)" )
    then
        modify($customer) {
            addDiscount(5.0),
            addAppliedRule("Large Purchase Bonus Discount (+5%)")
        }
        logger.info("[Business Rules Phase] Large Purchase Bonus Discount applied for: {}", $customer.getName());
end

// ==========================================
// 3. CUSTOMIZATION PHASE
// ==========================================

rule "Dummy Customization Rule"
    agenda-group "customization"
    salience 1000
    when
        $customer : CustomerFact()
    then
        logger.info("[Customization Phase] Running dynamic customizations for: {}", $customer.getName());
        $customer.addAppliedRule("[Phase: Customization] Tailoring specific offers");
end

rule "Generate Bonus Coupon for High Accumulated Discount"
    agenda-group "customization"
    salience 200
    when
        $customer : CustomerFact( discountPercentage >= 5.0 )
        not Coupon( code == "LOYALTY_BONUS" )
    then
        logger.info("[Customization Phase] Generating High-Spender LOYALTY_BONUS coupon for: {}", $customer.getName());
        insert(new Coupon("LOYALTY_BONUS", 10.0, false));
end

rule "Generate Premium Spender Coupon"
    agenda-group "customization"
    salience 200
    when
        $customer : CustomerFact( purchaseAmount >= 600.0 )
        not Coupon( code == "PREMIUM_SPENDER" )
    then
        logger.info("[Customization Phase] Generating PREMIUM_SPENDER coupon for: {}", $customer.getName());
        insert(new Coupon("PREMIUM_SPENDER", 15.0, false));
end

rule "Resolve Coupon Conflict - Disable Lower Value Coupon"
    agenda-group "customization"
    salience 180
    when
        $c1 : Coupon( used == false, $code1 : code, $val1 : discountVal )
        $c2 : Coupon( used == false, code != $code1, $val2 : discountVal )
        eval($val1 > $val2 || ($val1 == $val2 && $code1.compareTo($c2.getCode()) > 0))
    then
        logger.info("[Customization Phase] Coupon conflict detected! Disabling lower value coupon: {} in favor of: {}", $c2.getCode(), $code1);
        modify($c2) {
            setUsed(true)
        }
end

// ==========================================
// 4. POST-PROCESSING PHASE
// ==========================================

rule "Dummy Post-Processing Rule"
    agenda-group "post-processing"
    salience 1000
    when
        $customer : CustomerFact()
    then
        logger.info("[Post-Processing Phase] Finalizing totals and rule summary for: {}", $customer.getName());
        $customer.addAppliedRule("[Phase: Post-Processing] Evaluation sequence completed");
end

rule "Apply Unused Coupon"
    agenda-group "post-processing"
    salience 100
    when
        $coupon : Coupon( used == false, $code : code, $val : discountVal )
        $customer : CustomerFact()
    then
        logger.info("[Post-Processing Phase] Applying Coupon: {} (+{}%) for: {}", $code, $val, $customer.getName());
        modify($coupon) {
            setUsed(true)
        }
        modify($customer) {
            addDiscount($val),
            addAppliedRule("Applied Coupon: " + $code + " (+" + $val + "%)")
        }
end
